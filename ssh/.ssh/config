# SSH Config
# Keys managed via 1Password SSH Agent (never stored on disk)
# Managed via stow from ~/.dotfiles/ssh/

Include ~/.orbstack/ssh/config

# Machine-local hosts (never committed) — same idea as ~/.mix-extra.
# bootstrap.sh moves a pre-existing real ~/.ssh/config here.
Include config.local

# 1Password SSH Agent — works on any machine with 1Password installed
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Role-tagged hosts — only loaded when this machine's profile
# (~/.config/dotfiles/profile) carries the tag. Keep these last: everything
# after a Match line belongs to that Match block.
Match exec "grep -qw personal ~/.config/dotfiles/profile 2>/dev/null"
  Include config.d/personal

Match exec "grep -qw work ~/.config/dotfiles/profile 2>/dev/null"
  Include config.d/work
