# SSH Config
# Keys managed via 1Password SSH Agent (never stored on disk)
# Managed via stow from ~/.dotfiles/ssh/

Include ~/.orbstack/ssh/config

# 1Password SSH Agent — works on any machine with 1Password installed
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

