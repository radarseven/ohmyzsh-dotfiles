# SSH Config
# Keys live in ~/.ssh/keys/ (not committed to dotfiles)
# Managed via stow from ~/.dotfiles/ssh/

Include ~/.orbstack/ssh/config

# Global identity
IdentityFile ~/.ssh/id_ed25519

# ─── LOCAL ────────────────────────────────────────────────
# Home Assistant
Host ha
  HostName homeassistant.local
  User root
  Port 22222
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# ─── WP ENGINE ────────────────────────────────────────────
# Git push
Host git.wpengine.com
  User git
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/wpegitkey
  IdentitiesOnly yes

# Mainstay (staging)
Host mainstaystg
  Hostname mainstaystg.ssh.wpengine.net
  User mainstaystg
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_rsa
  IdentitiesOnly yes

