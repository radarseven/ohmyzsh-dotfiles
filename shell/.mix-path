# --- PATH ------------------------------------

# Primary PATH (works on both Intel and Apple Silicon)
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/bin

# rbenv (if installed)
if which rbenv > /dev/null; then eval "$(rbenv init -)"; fi

# NPM global packages
# https://docs.npmjs.com/getting-started/fixing-npm-permissions
export PATH=~/.npm-global/bin:$PATH

# Laravel Composer
export PATH=$PATH:$HOME/.composer/vendor/bin
